#: source/blender/nodes/geometry/nodes/node_geo_grease_pencil_to_curves.cc:25
msgid "Select the layers to convert"
msgstr "選擇要轉換的圖層"

#: source/blender/nodes/geometry/nodes/node_geo_grease_pencil_to_curves.cc:28
msgid "Create a separate curve instance for every layer"
msgstr "為每個圖層建立單獨的曲線例項"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:257
msgid "The input grid must have a uniform voxel scale to be advected."
msgstr "輸入柵格必須具有均勻的體素尺度才能被平流。"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:42
msgid "Semi-Lagrangian"
msgstr "半拉格朗日"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:43
msgid ""
"1st order semi-Lagrangian integration. Fast but least accurate, suitable for"
" simple advection"
msgstr "一階半拉格朗日 (Semi-Lagrangian) 積分法。計算速度快但精度較低，適用於簡單平流"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:49
msgid ""
"2nd order midpoint integration. Good balance between speed and accuracy for "
"most cases"
msgstr "二階中點積分法。在多數情況下，速度與精度之間具有良好的平衡"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:53
msgid "Runge-Kutta 3"
msgstr "龍格-庫塔 3"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:54
msgid ""
"3rd order Runge-Kutta integration. Higher accuracy at moderate computational"
" cost"
msgstr "三階龍格-庫塔 (Runge-Kutta) 積分法。可在中等計算成本下獲得更高精度"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:58
msgid "Runge-Kutta 4"
msgstr "龍格-庫塔 4"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:59
msgid ""
"4th order Runge-Kutta integration. Highest accuracy single-step method but "
"slower"
msgstr "四階龍格-庫塔 (Runge-Kutta) 積分法。單步法精度最高，但速度較慢"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:63
msgid "MacCormack"
msgstr "麥科馬克"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:64
msgid ""
"MacCormack scheme with implicit diffusion control. Reduces numerical "
"dissipation while maintaining stability"
msgstr "隱式擴散控制的麥科馬克 (MacCormack) 方案。在保持穩定性的同時減少數值耗散"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:69
msgid "BFECC"
msgstr "BFECC"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:70
msgid ""
"Back and Forth Error Compensation and Correction. Advanced scheme that "
"minimizes dissipation and diffusion"
msgstr ""
"來回誤差補償與校正 (Back and Forth Error Compensation and Correction "
"的縮寫)。一種能最大限度減少能量耗散與擴散的先進方案"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:80
msgid ""
"No limiting applied. Fastest but may produce artifacts in high-order schemes"
msgstr "未應用任何限制。最快，但可能在高階方案中產生偽影"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:85
msgid ""
"Clamp values to the range of the original neighborhood. Prevents "
"overshooting and undershooting"
msgstr "將數值限制在原始鄰域範圍內。防止過沖和下衝"

# cblc
#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:90
#: source/blender/windowmanager/intern/wm_files.cc:2811
#: source/blender/windowmanager/intern/wm_files.cc:3489
msgid "Revert"
msgstr "恢復"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:91
msgid ""
"Revert to 1st order integration when clamping would be applied. More "
"conservative than clamping"
msgstr "當要施加鉗制時，切換回一階積分。比鉗制策略更保守"

# rblc
#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:118
msgid "Integration Scheme"
msgstr "積分方案"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:123
msgid "Limiter"
msgstr "限制"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:117
msgid "Time step for advection in seconds"
msgstr "平流的時間步長，單位秒"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:122
msgid "Numerical integration method for advection"
msgstr "平流的數值積分法"

#: source/blender/nodes/geometry/nodes/node_geo_grid_advect.cc:127
msgid "Limiting strategy to prevent numerical artifacts"
msgstr "防止數字失真偽影的限制策略"

