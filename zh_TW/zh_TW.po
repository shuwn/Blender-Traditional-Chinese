msgctxt "Operator"
msgid "Copy"
msgstr "複製"

#. :src: bpy.types.SEQUENCER_OT_copy
msgid "Copy the selected strips to the internal clipboard"
msgstr "將選定的片段複製到內部剪貼簿"

#. :src: bpy.types.SEQUENCER_OT_cursor_set.location
msgid "Cursor location in normalized preview coordinates"
msgstr "以歸一化後的預覽座標表示的遊標位置"

#. :src: bpy.types.SEQUENCER_OT_delete
msgid "Delete selected strips from the sequencer"
msgstr "從序列編輯器中刪除選中的片段"

#. :src: bpy.types.SEQUENCER_OT_delete.delete_data
msgid "Delete Data"
msgstr "刪除資料"

#. :src: bpy.types.SEQUENCER_OT_delete.delete_data
msgid "After removing the Strip, delete the associated data also"
msgstr "刪除片段後，也刪除關聯的資料"

#. :src: bpy.types.SEQUENCER_OT_disconnect
msgctxt "Operator"
msgid "Disconnect Strips"
msgstr "斷開片段"

#. :src: bpy.types.SEQUENCER_OT_disconnect
msgid "Unlink selected strips so that they can be selected individually"
msgstr "解除選中片段的連線，以便可以單獨選擇"

#. :src: bpy.types.SEQUENCER_OT_duplicate
#. :src: bpy.types.SEQUENCER_OT_duplicate_move.SEQUENCER_OT_duplicate
#. :src: bpy.types.SEQUENCER_OT_duplicate_move_linked.SEQUENCER_OT_duplicate
#. :src: bpy.types.SEQUENCER_OT_preview_duplicate_move.SEQUENCER_OT_duplicate
#. :src:
#. bpy.types.SEQUENCER_OT_preview_duplicate_move_linked.SEQUENCER_OT_duplicate
msgid "Duplicate the selected strips"
msgstr "複製已選擇的片段"

#. :src: bpy.types.SEQUENCER_OT_duplicate.linked
msgid "Duplicate strip but not strip data, linking to the original data"
msgstr "複製片段但不復製片段資料, 而是關聯至原始資料"

#. :src: bpy.types.SEQUENCER_OT_duplicate_move
#. :src: bpy.types.SEQUENCER_OT_preview_duplicate_move
msgid "Duplicate selected strips and move them"
msgstr "複製並移動選中的片段"

#. :src: bpy.types.SEQUENCER_OT_duplicate_move.TRANSFORM_OT_seq_slide
#. :src: bpy.types.SEQUENCER_OT_duplicate_move_linked.TRANSFORM_OT_seq_slide
