#: source/blender/editors/io/io_stl_ops.cc:122
msgid "Apply Modifiers"
msgstr "應用修改器"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers
msgid ""
"Apply modifiers to mesh objects (except Armature ones) - WARNING: prevents "
"exporting shape keys"
msgstr "應用修改器到網格物體 (除骨架外) - 警告: 禁止匯出形態鍵"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers_render
msgid "Use Modifiers Render Setting"
msgstr "用修改器算繪設定"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_mesh_modifiers_render
msgid ""
"Use render settings when applying modifiers to mesh objects (DISABLED in "
"Blender 2.8)"
msgstr "在對網格物件應用修改器時使用算繪設定 (在 Blender 2.8 中禁用)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_metadata
msgid "Use Metadata"
msgstr "使用後設資料"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_selection
msgid "Export selected and visible objects only"
msgstr "僅匯出選中且可見物體"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_space_transform
msgid "Use Space Transform"
msgstr "使用空間變換"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_space_transform
msgid ""
"Apply global space transform to the object rotations. When disabled only the"
" axis space is written to the file and all object transforms are left as-is"
msgstr "將全域性空間變換應用於物體旋轉。禁用時，僅將軸空間寫入檔案，並且所有物體變換都保持原樣"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_subsurf
msgid "Export Subdivision Surface"
msgstr "匯出表面細分"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_subsurf
msgid ""
"Export the last Catmull-Rom subdivision modifier as FBX subdivision (does "
"not apply the modifier even if 'Apply Modifiers' is enabled)"
msgstr "將最後一個 Catmull-Rom 細分修改器匯出為 FBX 細分 (即使啟用了 \"應用修改器\"，也不應用修改器)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_triangles
msgid "Triangulate Faces"
msgstr "三角面"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_triangles
msgid "Convert all faces to triangles"
msgstr "將所有面轉換為三角面"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_tspace
msgid ""
"Add binormal and tangent vectors, together with normal they form the tangent"
" space (will only work correctly with tris/quads only meshes!)"
msgstr "新增副法線和切向向量, 與來自切向空間的法線一起 (僅能在三角/四邊網格內正確執行!)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_visible
#. :src: bpy.types.EXPORT_SCENE_OT_gltf.use_visible
msgid "Visible Objects"
msgstr "可見物體"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_visible
#. :src: bpy.types.EXPORT_SCENE_OT_gltf.use_visible
msgid "Export visible objects only"
msgstr "僅匯出可見的物體"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.at_collection_center
msgid "Export at Collection Center"
msgstr "位於集合中心匯出"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.at_collection_center
msgid "Export at Collection center of mass of root objects of the collection"
msgstr "在集合根物件的集合質心處匯出"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_action_filter
msgid "Filter Actions"
msgstr "過濾動作"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_action_filter
msgid "Filter Actions to be exported"
msgstr "過濾將被匯出的動作"

#. :src:
#. bpy.types.EXPORT_SCENE_OT_gltf.export_active_vertex_color_when_no_material
msgid "Export Active Vertex Color When No Material"
msgstr "無材質時匯出活動頂點色"

#. :src:
#. bpy.types.EXPORT_SCENE_OT_gltf.export_active_vertex_color_when_no_material
msgid "When there is no material on object, export active vertex color"
msgstr "當物體沒有材質時，匯出活動的頂點色"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_all_influences
msgid "Include All Bone Influences"
msgstr "包含全部骨骼影響"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_all_influences
msgid ""
"Allow export of all joint vertex influences. Models may appear incorrectly "
"in many viewers"
msgstr "允許匯出所有關節頂點影響的內容，在許多檢視器中可能出現錯誤"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_all_vertex_colors
msgid "Export All Vertex Colors"
msgstr "匯出所有頂點色"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_all_vertex_colors
msgid ""
"Export all vertex colors, even if not used by any material. If no Vertex "
"Color is used in the mesh materials, a fake COLOR_0 will be created, in "
"order to keep material unchanged"
msgstr "即使未被任何材質使用也匯出所有頂點色，如果網格材質中未使用頂點色，則會建立一個假的 COLOR_0，以保持材質不變"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_scene_split_object
msgid "Split Animation by Object"
msgstr "按物體分割動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_scene_split_object
msgid "Export Scene as seen in Viewport, But split animation by Object"
msgstr "匯出在視口中看到的場景，但按物件分割動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_single_armature
msgid "Export all Armature Actions"
msgstr "匯出所有骨架動作"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_single_armature
msgid ""
"Export all actions, bound to a single armature. WARNING: Option does not "
"support exports including multiple armatures"
msgstr "匯出繫結到單個骨架的所有動作。警告：選項不支援匯出包含多個骨架"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_slide_to_zero
msgid "Set All glTF Animation Starting at 0"
msgstr "設定所有glTF動畫起始位置在0"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_anim_slide_to_zero
msgid ""
"Set all glTF animation starting at 0.0s. Can be useful for looping "
"animations"
msgstr "將所有glTF動畫從0.0s開始設定，這對迴圈動畫很有用"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode
msgid "Animation Mode"
msgstr "動畫模式"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode
msgid "Export Animation mode"
msgstr "匯出動畫的模式"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIONS'
msgid "Export actions (actives and on NLA tracks) as separate animations"
msgstr "將動作（活動的和NLA軌跡上的動作）匯出為單獨的動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "Active actions merged"
msgstr "合併的活動動作"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'ACTIVE_ACTIONS'
msgid "All the currently assigned actions become one glTF animation"
msgstr "所有當前分配的動作都成為一個glTF動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid "Broadcast actions"
msgstr "廣播動作"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'BROADCAST'
msgid ""
"Broadcast all compatible actions to all objects. Animated objects will get "
"all actions compatible with them, others will get no animation at all"
msgstr "將所有相容的動作廣播到所有物件。動畫物件將獲得與其相容的所有動作，其他物件將完全不獲得動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'NLA_TRACKS'
msgid "Export individual NLA Tracks as separate animation"
msgstr "將單個NLA軌道匯出為單獨的動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animation_mode:'SCENE'
msgid "Export baked scene as a single animation"
msgstr "將烘焙過的場景匯出為單個動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_animations
msgid "Exports active actions and NLA tracks as glTF animations"
msgstr "匯出活動的動作和NLA軌道作為 glTF 動畫"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_apply
msgid ""
"Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents "
"exporting shape keys"
msgstr "應用修改器到網格物體 (除骨架外) - 警告: 禁止匯出形態鍵"

#. :src: bpy.types.EXPORT_SCENE_OT_gltf.export_armature_object_remove
msgid "Remove Armature Object"
msgstr "移除骨架物體"

