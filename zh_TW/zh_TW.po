#. :src: bpy.types.ASSET_OT_catalog_delete
msgctxt "Operator"
msgid "Delete Asset Catalog"
msgstr "刪除資產目錄"

#. :src: bpy.types.ASSET_OT_catalog_delete
msgid ""
"Remove an asset catalog from the asset library (contained assets will not be"
" affected and show up as unassigned)"
msgstr "從資產庫中刪除資產目錄 (已包含的資產不會受到影響，並顯示為未指定)"

#. :src: bpy.types.ASSET_OT_catalog_delete.catalog_id
msgid "Catalog ID"
msgstr "目錄ID"

#. :src: bpy.types.ASSET_OT_catalog_delete.catalog_id
msgid "ID of the catalog to delete"
msgstr "要刪除的目錄 ID"

#. :src: bpy.types.ASSET_OT_catalog_new
msgctxt "Operator"
msgid "New Asset Catalog"
msgstr "新建資產目錄"

#. :src: bpy.types.ASSET_OT_catalog_new
msgid "Create a new catalog to put assets in"
msgstr "建立新的目錄以放置資產"

#. :src: bpy.types.ASSET_OT_catalog_new.parent_path
msgid "Parent Path"
msgstr "父路徑"

#. :src: bpy.types.ASSET_OT_catalog_new.parent_path
msgid "Optional path defining the location to put the new catalog under"
msgstr "定義放置新目錄位置的可選路徑"

#. :src: bpy.types.ASSET_OT_catalog_redo
msgctxt "Operator"
msgid "Redo Catalog Edits"
msgstr "重做目錄編輯"

#. :src: bpy.types.ASSET_OT_catalog_redo
msgid "Redo the last undone edit to the asset catalogs"
msgstr "重做上一步被撤銷的資產目錄編輯操作"

#. :src: bpy.types.ASSET_OT_catalog_undo
msgctxt "Operator"
msgid "Undo Catalog Edits"
msgstr "撤銷目錄編輯"

#. :src: bpy.types.ASSET_OT_catalog_undo
msgid "Undo the last edit to the asset catalogs"
msgstr "撤銷資產目錄的最後一次編輯"

#. :src: bpy.types.ASSET_OT_catalog_undo_push
msgctxt "Operator"
msgid "Store undo snapshot for asset catalog edits"
msgstr "儲存資產目錄編輯的撤銷快照"

#. :src: bpy.types.ASSET_OT_catalog_undo_push
msgid "Store the current state of the asset catalogs in the undo buffer"
msgstr "將資產目錄的當前狀態儲存在撤銷緩衝區中"

#. :src: bpy.types.ASSET_OT_catalogs_save
msgctxt "Operator"
msgid "Save Asset Catalogs"
msgstr "儲存資產目錄"

#. :src: bpy.types.ASSET_OT_catalogs_save
msgid ""
"Make any edits to any catalogs permanent by writing the current set up to "
"the asset library"
msgstr "將當前設定寫入資產庫，使任何目錄的任何編輯永久化"

#. :src: bpy.types.ASSET_OT_clear
#: scripts/startup/bl_ui/space_filebrowser.py:748
#: scripts/startup/bl_ui/space_filebrowser.py:959
#: scripts/startup/bl_ui/space_outliner.py:376
#: scripts/startup/bl_ui/space_view3d.py:3557
#: source/blender/editors/interface/interface_context_menu.cc:1097
msgctxt "Operator"
msgid "Clear Asset"
msgstr "清除資產"

#. :src: bpy.types.ASSET_OT_clear
msgid ""
"Delete all asset metadata and turn the selected asset data-blocks back into "
"normal data-blocks"
msgstr "刪除所有資產後設資料，將選定的資產資料塊重新轉換為普通資料塊"

#. :src: bpy.types.ASSET_OT_clear.set_fake_user
#. :src: bpy.types.ASSET_OT_clear_single.set_fake_user
msgid "Set Fake User"
msgstr "設定偽使用者"

#. :src: bpy.types.ASSET_OT_clear.set_fake_user
#. :src: bpy.types.ASSET_OT_clear_single.set_fake_user
msgid ""
"Ensure the data-block is saved, even when it is no longer marked as asset"
msgstr "確保資料塊被儲存，即使它不再標記為資產"

#. :src: bpy.types.ASSET_OT_clear_single
msgctxt "Operator"
msgid "Clear Single Asset"
msgstr "清除單個資產"

#. :src: bpy.types.ASSET_OT_clear_single
msgid ""
"Delete all asset metadata and turn the asset data-block back into a normal "
"data-block"
msgstr "刪除所有資產後設資料，將資產資料塊重新轉換為普通資料塊"

#. :src: bpy.types.ASSET_OT_library_refresh
msgctxt "Operator"
msgid "Refresh Asset Library"
msgstr "重新整理資產庫"

#. :src: bpy.types.ASSET_OT_library_refresh
msgid "Reread assets and asset catalogs from the asset library on disk"
msgstr "從磁碟上的資產庫重讀資產和資產目錄"

#. :src: bpy.types.ASSET_OT_library_refresh.use_remote_listing
msgid "Remote Listing"
msgstr "遠端列表"

#. :src: bpy.types.ASSET_OT_library_refresh.use_remote_listing
#. :src: bpy.types.ASSET_OT_library_reload_listing
msgid ""
"Re-download the asset listing of a remote library. Only supported when the "
"active asset library is remote or has a remote component (the Essentials "
"library)"
msgstr "重新下載遠端庫的資產列表。僅當活動資產庫為遠端庫或包含遠端元件（基礎庫）時才支援此功能"

#. :src: bpy.types.ASSET_OT_library_refresh.use_shift_for_remote_listing
msgid "Use Shift for Remote Listing"
msgstr "按 Shift 獲取遠端列表"

#. :src: bpy.types.ASSET_OT_library_refresh.use_shift_for_remote_listing
msgid ""
"When this operator is invoked and the Shift key is pressed, download the "
"remote asset library listing"
msgstr "呼叫此操作時若按下 Shift 鍵，則下載遠端資產庫的列表"

#. :src: bpy.types.ASSET_OT_library_reload_listing
msgctxt "Operator"
msgid "Reload Remote Asset Library Listing"
msgstr "重新載入遠端資產庫列表"

#. :src: bpy.types.ASSET_OT_mark
#: source/blender/editors/interface/interface_context_menu.cc:1092
msgctxt "Operator"
msgid "Mark as Asset"
msgstr "標記為資產"

#. :src: bpy.types.ASSET_OT_mark
msgid ""
"Enable easier reuse of selected data-blocks through the Asset Browser, with "
"the help of customizable metadata (like previews, descriptions and tags)"
