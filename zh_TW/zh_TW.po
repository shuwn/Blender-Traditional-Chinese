msgstr "啟用工具的按鍵方法，例如移動、旋轉和縮放 (G，R，S)"

#. :src: bpy.types.Prefs.tool_key_mode:'IMMEDIATE'
msgid "Immediate"
msgstr "立刻"

#. :src: bpy.types.Prefs.tool_key_mode:'IMMEDIATE'
