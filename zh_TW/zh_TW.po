msgid "Vector which would be mapped to the curve"
msgstr "將被對映到曲線上的向量"

#: source/blender/nodes/shader/nodes/node_shader_curves.cc:179
msgid "Amount of influence the node exerts on the output color"
msgstr "節點施加給輸出顏色的影響程度"

#: source/blender/nodes/shader/nodes/node_shader_displacement.cc:20
msgid "Distance to displace the surface along the normal"
msgstr "沿法向置換表面的距離"

#: source/blender/nodes/shader/nodes/node_shader_displacement.cc:25
#: source/blender/nodes/shader/nodes/node_shader_vector_displacement.cc:22
msgid ""
"Neutral displacement value that causes no displacement.\n"
"Lower values cause the surface to move inwards, higher values push the surface outwards"
msgstr ""
"中點位移值影響置換．\n"
"較低的值會導致表面向內移動，較高的值則會向外推"

#: source/blender/nodes/shader/nodes/node_shader_displacement.cc:33
