"Find the number of times a given string occurs in another string and the "
"position of the first match"
msgstr "查詢給定字串在另一個字串中出現的次數以及首個匹配位置"

#. :src: bpy.types.FunctionNodeFloatToInt
msgid "Float to Integer"
msgstr "浮點數 轉為 整數"

#. :src: bpy.types.FunctionNodeFloatToInt
msgid ""
"Convert the given floating-point number to an integer, with a choice of "
"methods"
msgstr "選擇多個方法中的一種，將給定的浮點數轉換為整數"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode
msgctxt "NodeTree"
msgid "Rounding Mode"
msgstr "舍入模式"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode
msgid "Method used to convert the float to an integer"
msgstr "用於將浮點數轉換為整數的方法"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'ROUND'
#. :src: bpy.types.ShaderNodeMath.operation:'ROUND'
#. :src: bpy.types.ShaderNodeVectorMath.operation:'ROUND'
#. :src: bpy.types.TextureNodeMath.operation:'ROUND'
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'ROUND'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'ROUND'
msgctxt "NodeTree"
msgid "Round"
msgstr "四捨五入"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'ROUND'
msgid "Round the float up or down to the nearest integer"
msgstr "將浮點向上或向下舍入到最接近的整數"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'FLOOR'
#. :src: bpy.types.ShaderNodeMath.operation:'FLOOR'
#. :src: bpy.types.ShaderNodeVectorMath.operation:'FLOOR'
#. :src: bpy.types.TextureNodeMath.operation:'FLOOR'
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'FLOOR'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'FLOOR'
msgctxt "NodeTree"
msgid "Floor"
msgstr "向下取整"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'FLOOR'
