msgstr "形狀維持"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "How much of the original shape is preserved when smoothing"
msgstr "平滑時保留原始形狀的程度"

#. :src: bpy.types.Brush.texture_overlay_alpha
msgid "Texture Overlay Alpha"
msgstr "紋理疊加Alpha"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Texture Sample Bias"
msgstr "紋理有偏取樣"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Value added to texture samples"
msgstr "紋理取樣增加值"

#. :src: bpy.types.Brush.texture_slot
#. :src: bpy.types.TextureSlot
msgid "Texture Slot"
msgstr "紋理槽"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid "Tilt Strength"
msgstr "傾斜強度"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid ""
"How much the tilt of the pen will affect the brush. Negative values indicate"
" inverting the tilt directions."
msgstr "筆的傾斜度對筆刷的影響程度。負值表示傾斜方向相反。"

#. :src: bpy.types.Brush.tip_roundness
#. :src: Socket name from node group Duplicate Hair Curves, file
#. procedural_hair_node_assets.blend
msgid "Tip Roundness"
msgstr "梢部圓度"

#. :src: bpy.types.Brush.tip_roundness
msgid "Roundness of the brush tip"
msgstr "筆刷頭部的圓度"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Tip Scale X"
msgstr "梢部縮放"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Scale of the brush tip in the X axis"
msgstr "筆刷頭部的X向縮放"

#. :src: bpy.types.Brush.topology_rake_factor
msgid "Topology Rake"
msgstr "拓撲耙(Topology Rake)"

#. :src: bpy.types.Brush.topology_rake_factor
msgid ""
"Automatically align edges to the brush direction to generate cleaner "
"topology and define sharp features. Best used on low-poly meshes as it has a"
" performance impact."
msgstr "自動對齊邊線與筆刷方向，以生成清晰而且銳利特徵明確的動態拓撲。最適用於低多邊形網格，因為它會影響效能。"

#. :src: bpy.types.Brush.unprojected_size
#. :src: bpy.types.UnifiedPaintSettings.unprojected_size
msgid "Unprojected Size"
msgstr "未投影尺寸"

#. :src: bpy.types.Brush.unprojected_size
#. :src: bpy.types.UnifiedPaintSettings.unprojected_size
msgid "Diameter of brush in Blender units"
msgstr "筆刷直徑 (Blender單位)"

#. :src: bpy.types.Brush.use_accumulate
#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_accumulate
msgid "Accumulate"
msgstr "累積"

#. :src: bpy.types.Brush.use_accumulate
msgid "Accumulate stroke daubs on top of each other"
msgstr "筆畫顏料相互疊加"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Adaptive Spacing"
msgstr "自適配間隔"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr "間隔顏料參照表層的座標空間, 而非螢幕座標空間"

#. :src: bpy.types.Brush.use_alpha
#. :src: bpy.types.PAINT_OT_vertex_color_set.use_alpha
msgid "Affect Alpha"
msgstr "影響Alpha"

#. :src: bpy.types.Brush.use_alpha
msgid "When this is disabled, lock alpha while painting"
msgstr "當此項禁用時, 將在繪畫時鎖定alpha"

#. :src: bpy.types.Brush.use_bidirectional
msgid "Bidirectional"
msgstr "雙向"

#. :src: bpy.types.Brush.use_bidirectional
msgid ""
"Project vertices both along the projection direction and its inverse, "
"choosing the closest intersection."
msgstr "同時沿投影方向及其反方向投影頂點，選擇最近的交點。"

#. :src: bpy.types.Brush.use_cloth_collision
msgid "Collide with objects during the simulation"
msgstr "模擬過程中與物體碰撞"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid "Pin Simulation Boundary"
msgstr "釘固模擬邊界"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid ""
"Lock the position of the vertices in the simulation falloff area to avoid "
"artifacts and create a softer transition with unaffected areas"
msgstr "鎖定模擬衰減區域中頂點的位置，以避免缺陷，並建立與未受影響區域的更柔和過渡"

#. :src: bpy.types.Brush.use_color_as_displacement
msgid ""
"Handle each pixel color as individual vector for displacement (area plane "
"mapping only)"
msgstr "將每個畫素顏色作為置換的單個向量進行處理 (僅適用於區域平面對映)"

#. :src: bpy.types.Brush.use_color_jitter
#. :src: bpy.types.UnifiedPaintSettings.use_color_jitter
msgid "Use Color Jitter"
msgstr "使用顏色抖動"

#. :src: bpy.types.Brush.use_color_jitter
#. :src: bpy.types.UnifiedPaintSettings.use_color_jitter
msgid "Jitter brush color"
msgstr "抖動筆刷顏色"

#. :src: bpy.types.Brush.use_connected_only
#. :src: bpy.types.ToolSettings.use_proportional_connected
msgid "Connected Only"
msgstr "僅相連項"

#. :src: bpy.types.Brush.use_connected_only
msgid "Affect only topologically connected elements"
msgstr "僅影響拓撲連線的元素"

#. :src: bpy.types.Brush.use_cursor_overlay
msgid "Use Cursor Overlay"
msgstr "使用遊標疊加"

#. :src: bpy.types.Brush.use_cursor_overlay
msgid "Show cursor in viewport"
msgstr "檢視中顯示遊標"

# pblc
#. :src: bpy.types.Brush.use_cursor_overlay_override
#. :src: bpy.types.Brush.use_primary_overlay_override
#. :src: bpy.types.Brush.use_secondary_overlay_override
msgid "Override Overlay"
msgstr "重寫疊加層"

