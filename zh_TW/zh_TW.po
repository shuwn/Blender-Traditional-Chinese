msgstr "自發光顏色"

#: source/blender/nodes/shader/nodes/node_shader_eevee_specular.cc:29
msgid "Transparency"
msgstr "透明"

#: source/blender/nodes/shader/nodes/node_shader_eevee_specular.cc:35
