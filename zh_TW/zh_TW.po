#. bpy.types.SEQUENCER_OT_retiming_add_transition_slide.TRANSFORM_OT_seq_slide
#. :src: bpy.types.TRANSFORM_OT_seq_slide
msgid "Slide a sequence strip in time"
msgstr "在一定時間內滑動序列片段"

#. :src: bpy.types.SEQUENCER_OT_duplicate_move_linked
#. :src: bpy.types.SEQUENCER_OT_preview_duplicate_move_linked
msgid "Duplicate selected strips, but not their data, and move them"
msgstr "複製所選片段但不復制其資料，然後移動"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add
msgctxt "Operator"
msgid "Add Effect Strip"
msgstr "新增特效片段"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add
msgid ""
"Add an effect to the sequencer, most are applied on top of existing strips"
msgstr "為序列新增一個特效, 一般應用在最頂層的片段上"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.color
msgid "Initialize the strip with this color"
msgstr "使用該顏色初始化該片段"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.height
#. :src: bpy.types.ColorStrip.height
msgid "Height of the color strip in pixels"
msgstr "顏色片段的高度，單位為畫素"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.length
#. :src: bpy.types.SEQUENCER_OT_image_strip_add.length
#. :src: bpy.types.SEQUENCER_OT_text_strip_add.length
msgid ""
"Length of the strip in frames, or the length of each strip if multiple are "
"added"
msgstr "片段的幀長度，或新增多個片段時每個片段的長度"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.type
msgid "Sequencer effect type"
msgstr "序列編輯器特效型別"

#. :src: bpy.types.SEQUENCER_OT_effect_strip_add.width
#. :src: bpy.types.ColorStrip.width
msgid "Width of the color strip in pixels"
msgstr "顏色片段的寬度，單位為畫素"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies
msgctxt "Operator"
msgid "Set Selected Strip Proxies"
msgstr "設定已選中片段代理"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies
msgid "Enable selected proxies on all selected Movie and Image strips"
msgstr "對所有選中的影片和影象片段啟用選中的代理"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies.overwrite
msgid "Overwrite existing proxy files"
msgstr "覆蓋現有代理檔案"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies.proxy_100
msgid "Build proxy at 100% resolution"
msgstr "以 100% 解析度構建代理"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies.proxy_25
msgid "Build proxy at 25% resolution"
msgstr "以 25% 解析度構建代理"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies.proxy_50
msgid "Build proxy at 50% resolution"
msgstr "以 50% 解析度構建代理"

#. :src: bpy.types.SEQUENCER_OT_enable_proxies.proxy_75
msgid "Build proxy at 75% resolution"
msgstr "以 75% 解析度構建代理"

#. :src: bpy.types.SEQUENCER_OT_export_subtitles
#: scripts/startup/bl_ui/space_sequencer.py:507
msgctxt "Operator"
msgid "Export Subtitles"
msgstr "匯出字幕"

#. :src: bpy.types.SEQUENCER_OT_export_subtitles
msgid "Export .srt file containing text strips"
msgstr "匯出包含文字片段的 .srt 檔案"

#. :src: bpy.types.SEQUENCER_OT_fades_add.duration_seconds
msgid "Fade Duration"
msgstr "淡化持續時間"

#. :src: bpy.types.SEQUENCER_OT_fades_add.duration_seconds
msgid "Duration of the fade in seconds"
msgstr "淡化的持續時間 (以秒為單位)"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type
msgid "Fade Type"
msgstr "淡化型別"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type
msgid ""
"Fade in, out, both in and out, to, or from the current frame. Default is "
"both in and out"
msgstr "淡入、淡出，同時淡入和淡出、淡入或淡出當前幀。預設是同時進入和退出"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'IN_OUT'
msgid "Fade In and Out"
msgstr "淡入淡出"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'IN_OUT'
msgid "Fade selected strips in and out"
msgstr "淡化所選片段"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'IN'
msgid "Fade In"
msgstr "淡入"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'IN'
msgid "Fade in selected strips"
msgstr "淡入所選片段"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'OUT'
msgid "Fade Out"
msgstr "淡出"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'OUT'
msgid "Fade out selected strips"
msgstr "淡出所選片段"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'CURSOR_FROM'
msgid "From Current Frame"
msgstr "自當前幀"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'CURSOR_FROM'
msgid "Fade from the time cursor to the end of overlapping strips"
msgstr "從時間軸游標處淡化至重疊片段的末尾"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'CURSOR_TO'
msgid "To Current Frame"
msgstr "至當前幀"

#. :src: bpy.types.SEQUENCER_OT_fades_add.type:'CURSOR_TO'
msgid ""
"Fade from the start of strips under the time cursor to the current frame"
msgstr "從時間軸游標下的片段開始淡化至當前幀"

#. :src: bpy.types.SEQUENCER_OT_gap_insert
msgctxt "Operator"
msgid "Insert Gaps"
msgstr "插入間隙"

#. :src: bpy.types.SEQUENCER_OT_gap_insert
msgid ""
"Insert gap at current frame to first strips at the right, independent of "
"selection or locked state of strips"
msgstr "在當前幀與右側首個片段間插入間隙, 不依賴片段的選擇或鎖定狀態"

#. :src: bpy.types.SEQUENCER_OT_gap_insert.frames
msgid "Frames to insert after current strip"
msgstr "在當前片段之後插入的幀數"

#. :src: bpy.types.SEQUENCER_OT_gap_remove
msgctxt "Operator"
msgid "Remove Gaps"
msgstr "移除間隙"

#. :src: bpy.types.SEQUENCER_OT_gap_remove
msgid ""
"Remove gap at current frame to first strip at the right, independent of "
"selection or locked state of strips"
msgstr "移除當前幀與右側首個片段間的間隙，不依賴片段的選擇或鎖定狀態"

#. :src: bpy.types.SEQUENCER_OT_gap_remove.all
msgid "All Gaps"
msgstr "所有間隙"

#. :src: bpy.types.SEQUENCER_OT_gap_remove.all
msgid "Do all gaps to right of current frame"
msgstr "移除當前幀右側的所有間隙"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add
msgctxt "Operator"
msgid "Add Image Strip"
msgstr "新增影象片段"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add
msgid "Add an image or image sequence to the sequencer"
msgstr "新增一個影象或一套影象序列到序列編輯器中"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method
msgid "Mode for fitting the image to the canvas"
msgstr "將影象適配到畫布的模式"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'FIT'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'FIT'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'FIT'
#. :src: bpy.types.SequencerToolSettings.fit_method:'FIT'
msgid ""
"Fits the image bounds inside the canvas, avoiding crops while maintaining "
"aspect ratio"
msgstr "將影象邊界適配到畫布內，避免裁剪並保持寬高比"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'FILL'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'FILL'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'FILL'
#. :src: bpy.types.SequencerToolSettings.fit_method:'FILL'
msgid "Scale to Fill"
msgstr "縮放至填充"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'FILL'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'FILL'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'FILL'
#. :src: bpy.types.SequencerToolSettings.fit_method:'FILL'
msgid ""
"Fills the canvas edge-to-edge, cropping if needed, while maintaining aspect "
"ratio"
msgstr "沿畫布邊緣適配，必要時進行裁剪，同時保持寬高比"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'STRETCH'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'STRETCH'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'STRETCH'
#. :src: bpy.types.SequencerToolSettings.fit_method:'STRETCH'
msgid "Stretch to Fill"
msgstr "拉伸至填充"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'STRETCH'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'STRETCH'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'STRETCH'
#. :src: bpy.types.SequencerToolSettings.fit_method:'STRETCH'
msgid "Stretches image bounds to the canvas without preserving aspect ratio"
msgstr "將影象邊界拉伸到畫布上，不會保持寬高比"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'ORIGINAL'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'ORIGINAL'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'ORIGINAL'
#. :src: bpy.types.SequencerToolSettings.fit_method:'ORIGINAL'
msgid "Use Original Size"
msgstr "使用原始尺寸"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.fit_method:'ORIGINAL'
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.fit_method:'ORIGINAL'
#. :src: bpy.types.SEQUENCER_OT_strip_transform_fit.fit_method:'ORIGINAL'
#. :src: bpy.types.SequencerToolSettings.fit_method:'ORIGINAL'
msgid "Display image at its original size"
msgstr "以原始大小顯示影象"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type
msgid "Import As"
msgstr "匯入為"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type
msgid "Mode for importing selected images"
msgstr "匯入選定影象的模式"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type:'DETECT'
msgid "Auto Detect"
msgstr "自動檢測"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type:'DETECT'
msgid ""
"Add images as individual strips, unless their filenames match Blender's "
"numbered sequence pattern, in which case they are grouped into a single "
"image sequence"
msgstr "將影象作為獨立片段新增，除非其檔名能匹配 Blender 的編號序列模式，此時它們將被歸入單一影象序列"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type:'SEQUENCE'
msgid ""
"Import all selected images as a single image sequence. The sequence of "
"images does not have to match Blender's numbered sequence pattern, so "
"placeholders cannot be inferred"
msgstr "將所有選定影象匯入為單一影象序列。影象序列無需與 Blender 的編號序列模式匹配，因此無法推斷佔位符"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type:'INDIVIDUAL'
msgid "Individual Images"
msgstr "單獨影象"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.image_import_type:'INDIVIDUAL'
msgid "Add each selected image as an individual strip"
msgstr "將每張選定影象作為獨立片段新增"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.set_view_transform
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.set_view_transform
msgid "Set View Transform"
msgstr "設定檢視變換"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.set_view_transform
#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.set_view_transform
msgid "Set appropriate view transform based on media color space"
msgstr "根據媒體色彩空間設定適當的檢視變換"

#. :src: bpy.types.SEQUENCER_OT_image_strip_add.use_placeholders
msgid "Reserve placeholder frames for missing frames of the image sequence"
msgstr "為影象序列中缺失的幀保留佔位幀"

#. :src: bpy.types.SEQUENCER_OT_images_separate
msgctxt "Operator"
msgid "Separate Images"
msgstr "分離影象"

#. :src: bpy.types.SEQUENCER_OT_images_separate
msgid "On image sequence strips, it returns a strip for each image"
msgstr "對於影象序列片段, 將為每張影象建立一個單獨片段"

#. :src: bpy.types.SEQUENCER_OT_images_separate.length
msgid "Length of each frame"
msgstr "每幀的長度"

#. :src: bpy.types.SEQUENCER_OT_lock
msgctxt "Operator"
msgid "Lock Strips"
msgstr "鎖定片段"

#. :src: bpy.types.SEQUENCER_OT_lock
msgid "Lock strips so they cannot be transformed"
msgstr "鎖定片段使其無法變換"

#. :src: bpy.types.SEQUENCER_OT_mask_strip_add
msgctxt "Operator"
msgid "Add Mask Strip"
msgstr "新增遮罩片段"

#. :src: bpy.types.SEQUENCER_OT_mask_strip_add
msgid "Add a mask strip to the sequencer"
msgstr "向序列編輯器中新增一個遮罩片段"

#. :src: bpy.types.SEQUENCER_OT_mask_strip_add.mask
msgid "Mask to add as a strip"
msgstr "要作為片段新增的遮罩"

#. :src: bpy.types.SEQUENCER_OT_meta_make
msgctxt "Operator"
msgid "Make Meta Strip"
msgstr "生成複合片段"

#. :src: bpy.types.SEQUENCER_OT_meta_make
msgid "Group selected strips into a meta-strip"
msgstr "將選定的片段組合為一個複合片段"

#. :src: bpy.types.SEQUENCER_OT_meta_separate
msgctxt "Operator"
msgid "UnMeta Strip"
msgstr "解開復合片段"

#. :src: bpy.types.SEQUENCER_OT_meta_separate
msgid "Put the contents of a meta-strip back in the sequencer"
msgstr "將複合片段的內容分解放回至序列編輯器"

#. :src: bpy.types.SEQUENCER_OT_meta_toggle
msgctxt "Operator"
msgid "Toggle Meta Strip"
msgstr "切換複合片段"

#. :src: bpy.types.SEQUENCER_OT_meta_toggle
msgid "Toggle a meta-strip (to edit enclosed strips)"
msgstr "切換複合片段 (用於編輯封裝的片段)"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add
msgctxt "Operator"
msgid "Add Movie Strip"
msgstr "新增影片片段"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add
msgid "Add a movie strip to the sequencer"
msgstr "向序列編輯器中新增一個影片片段"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.adjust_playback_rate
msgid "Adjust Playback Rate"
msgstr "調整播放速率"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.adjust_playback_rate
msgid "Play at normal speed regardless of scene FPS"
msgstr "以正常速度播放，無視場景FPS"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.sound
msgid "Load sound with the movie"
msgstr "載入帶聲音的影片"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.use_framerate
msgid "Set Scene Frame Rate"
msgstr "設定場景影格率"

#. :src: bpy.types.SEQUENCER_OT_movie_strip_add.use_framerate
msgid "Set frame rate of the current scene to the frame rate of the movie"
msgstr "將當前場景的影格率設定為影片的影格率"

#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add
msgctxt "Operator"
msgid "Add MovieClip Strip"
msgstr "新增影片剪輯片段"

#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add
msgid "Add a movieclip strip to the sequencer"
msgstr "將一個影片剪輯片段新增到序列編輯器中"

#. :src: bpy.types.SEQUENCER_OT_movieclip_strip_add.clip
msgid "Movie clip to add as a strip"
msgstr "要作為片段新增的影片剪輯"

#. :src: bpy.types.SEQUENCER_OT_mute
msgctxt "Operator"
msgid "Mute Strips"
msgstr "遮蔽片段"

#. :src: bpy.types.SEQUENCER_OT_mute
msgid "Mute (un)selected strips"
msgstr "遮蔽所選片段"

#. :src: bpy.types.SEQUENCER_OT_mute.unselected
msgid "Mute unselected rather than selected strips"
msgstr "遮蔽未選片段, 而不是已選片段"

#. :src: bpy.types.SEQUENCER_OT_offset_clear
msgctxt "Operator"
msgid "Clear Strip Offset"
msgstr "清除片段偏移量"

#. :src: bpy.types.SEQUENCER_OT_offset_clear
msgid "Clear strip in/out offsets from the start and end of content"
msgstr "從內容開始和結束處清除片段 入/出 偏移量"

