msgstr "將表面視為從正面和背面都發光的取樣燈"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid "Bump Map Correction"
msgstr "凹凸貼圖校正"

#. :src: bpy.types.CyclesMaterialSettings.use_bump_map_correction
msgid ""
"Apply corrections to solve shadow terminator artifacts caused by bump "
"mapping"
msgstr "矯正當使用凹凸貼圖時陰影交界線的失真"

#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation
#. :src: bpy.types.CyclesWorldSettings.volume_interpolation
msgid "Volume Interpolation"
msgstr "體積插值"

#. :src: bpy.types.CyclesMaterialSettings.volume_interpolation
msgid "Interpolation method to use for smoke/fire volumes"
msgstr "用於煙/火體積的插值方法"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling
#. :src: bpy.types.CyclesWorldSettings.volume_sampling
msgid "Volume Sampling"
msgstr "體積取樣"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling
#. :src: bpy.types.CyclesWorldSettings.volume_sampling
msgid "Sampling method to use for volumes"
msgstr "使用體積的取樣方法"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'DISTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'DISTANCE'
msgid "Use distance sampling, best for dense volumes with lights far away"
msgstr "使用距離取樣，最適合遠距離體積密集的光線"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid "Equiangular"
msgstr "等角"

#. :src: bpy.types.CyclesMaterialSettings.volume_sampling:'EQUIANGULAR'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'EQUIANGULAR'
msgid ""
"Use equiangular sampling, best for volumes with low density with light "
"inside or near the volume"
msgstr "使用等角取樣，最適用於內部光線密度低的體積，或體積附近有光"

#. :src:
#. bpy.types.CyclesMaterialSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#: scripts/addons_core/cycles/ui.py:1701
msgid "Multiple Importance"
msgstr "多重重要性"

#. :src:
#. bpy.types.CyclesMaterialSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
#. :src: bpy.types.CyclesWorldSettings.volume_sampling:'MULTIPLE_IMPORTANCE'
msgid ""
"Combine distance and equiangular sampling for volumes where neither method "
"is ideal"
msgstr "對於兩種方法均不理想的體積，將距離取樣與等角取樣相結合"

#. :src: bpy.types.CyclesMaterialSettings.volume_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_preview_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_step_rate
msgid "Step Rate"
msgstr "步進率"

#. :src: bpy.types.CyclesMaterialSettings.volume_step_rate
msgid ""
"Scale the distance between volume shader samples when rendering the volume "
"(lower values give more accurate and detailed results, but also increased "
"render time)"
msgstr "縮放體積著色器取樣點之間的距離（較低的值可產生更精確、更細膩的結果，但也會增加算繪時間）"

#. :src: bpy.types.CyclesObjectSettings.ao_distance
#: scripts/addons_core/cycles/ui.py:726
msgid "AO Distance"
msgstr "AO 距離"

#. :src: bpy.types.CyclesObjectSettings.ao_distance
msgid ""
"AO distance used for approximate global illumination (0 means use world "
"setting)"
msgstr "用於近似全域性照明的AO距離 (0 表示使用世界設定)"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_caster
msgid "Cast Shadow Caustics"
msgstr "投射陰影焦散"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_caster
msgid ""
"With refractive materials, generate approximate caustics in shadows of this "
"object. Up to 10 bounces inside this object are taken into account. Lights, "
"caster and receiver objects must have shadow caustics options set to enable "
"this"
msgstr "對於折射材質，在此物體的陰影中產生近似焦散。此物體內部最多會考慮十次反彈。燈光、投射器和接收器物件必須設定陰影焦散選項才能啟用此功能"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_receiver
msgid "Receive Shadow Caustics"
msgstr "接收陰影焦散"

#. :src: bpy.types.CyclesObjectSettings.is_caustics_receiver
msgid ""
"Receive approximate caustics from refractive materials in shadows on this "
"object. Lights, caster and receiver objects must have shadow caustics "
"options set to enable this"
msgstr "從該物體上陰影中的折射材質接收近似焦散。燈光、投射器和接收器物體必須設定陰影焦散選項才能啟用此功能"

#. :src: bpy.types.CyclesObjectSettings.motion_steps
msgid "Motion Steps"
msgstr "運動步數"

#. :src: bpy.types.CyclesObjectSettings.motion_steps
msgid ""
"Control accuracy of motion blur, more steps gives more memory usage (actual "
"number of steps is 2^(steps - 1))"
msgstr "運動模糊的控制精度, 給與更多步數使用更多記憶體 (真實步數是 2^(步數 - 1))"

#. :src: bpy.types.CyclesObjectSettings.use_camera_cull
#. :src: bpy.types.CyclesRenderSettings.use_camera_cull
msgid "Use Camera Cull"
msgstr "使用攝像機剔除"

#. :src: bpy.types.CyclesObjectSettings.use_camera_cull
msgid ""
"Allow this object and its duplicators to be culled by camera space culling"
msgstr "允許此物體與它的副本被攝像機空間篩選剔除"

#. :src: bpy.types.CyclesObjectSettings.use_deform_motion
msgid "Use Deformation Motion"
msgstr "使用形變運動"

#. :src: bpy.types.CyclesObjectSettings.use_deform_motion
msgid "Use deformation motion blur for this object"
msgstr "對物體使用變形運動模糊"

#. :src: bpy.types.CyclesObjectSettings.use_distance_cull
#. :src: bpy.types.CyclesRenderSettings.use_distance_cull
msgid "Use Distance Cull"
msgstr "使用距離剔除"

#. :src: bpy.types.CyclesObjectSettings.use_distance_cull
msgid ""
"Allow this object and its duplicators to be culled by distance from camera"
msgstr "允許此物體與它的副本根據與攝像機間的距離被剔除"

#. :src: bpy.types.CyclesObjectSettings.use_motion_blur
msgid "Use Motion Blur"
msgstr "使用運動模糊"

#. :src: bpy.types.CyclesObjectSettings.use_motion_blur
msgid "Use motion blur for this object"
msgstr "對物體使用運動模糊"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_follow_reflections
msgid "Denoising Pass Reflections"
msgstr "降噪通道反射"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_pass_follow_reflections
msgid "Follow reflections for the denoising feature passes"
msgstr "跟隨用於降噪特徵通道的反射"

#. :src:
#. bpy.types.CyclesRenderLayerSettings.denoising_pass_use_albedo_roughness_weighting
#. :src:
#. bpy.types.ViewLayerEEVEE.denoising_pass_use_albedo_roughness_weighting
msgid "Denoising Pass Albedo Roughness Weighting"
msgstr "降噪通道反照率糙度加權"

#. :src:
#. bpy.types.CyclesRenderLayerSettings.denoising_pass_use_albedo_roughness_weighting
#. :src:
#. bpy.types.ViewLayerEEVEE.denoising_pass_use_albedo_roughness_weighting
msgid ""
"Use roughness-based weighting of the albedo for the denoising feature passes"
msgstr "對降噪特徵層採用基於糙度的反照率加權"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_store_passes
msgid "Store Denoising Passes"
msgstr "儲存降噪通道"

#. :src: bpy.types.CyclesRenderLayerSettings.denoising_store_passes
msgid ""
"Store the denoising feature passes and the noisy image. The passes adapt to "
"the denoiser selected for rendering"
msgstr "儲存降噪功能通道和噪點影象。通道適應為算繪選擇的降噪器"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_debug_sample_count
#: scripts/addons_core/cycles/engine.py:228
msgid "Debug Sample Count"
msgstr "除錯取樣計數"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_debug_sample_count
msgid ""
"Number of samples per pixel taken, divided by the maximum number of samples."
" To analyze adaptive sampling"
msgstr "每畫素採集的取樣，數除以最大采樣數，分析自適應取樣"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_render_time
#: scripts/addons_core/cycles/engine.py:232
#: scripts/addons_core/cycles/ui.py:1122
#: scripts/startup/bl_ui/properties_output.py:222
msgid "Render Time"
msgstr "算繪時間"

#. :src: bpy.types.CyclesRenderLayerSettings.pass_render_time
msgid ""
"Reports time per pixel in milliseconds. Supported only on CPU render devices"
msgstr "報告每畫素的毫秒時間。僅支援 CPU 算繪裝置"

#. :src: bpy.types.CyclesRenderLayerSettings.use_denoising
#. :src: bpy.types.CyclesRenderSettings.use_denoising
msgid "Use Denoising"
msgstr "使用降噪"

#. :src: bpy.types.CyclesRenderLayerSettings.use_denoising
#. :src: bpy.types.CyclesRenderSettings.use_denoising
msgid "Denoise the rendered image"
msgstr "對算繪影象降噪"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_shadow_catcher
msgid ""
"Pass containing shadows and light which is to be multiplied into backdrop"
msgstr "包含陰影和光線的通道，將乘入背景"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_direct
#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'VOLUME_DIRECT'
#: scripts/addons_core/cycles/engine.py:215
msgid "Volume Direct"
msgstr "體積直接光"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_direct
msgid "Deliver direct volumetric scattering pass"
msgstr "傳遞直接體積散射通道"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_indirect
#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'VOLUME_INDIRECT'
#: scripts/addons_core/cycles/engine.py:216
msgid "Volume Indirect"
msgstr "體積間接光"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_indirect
msgid "Deliver indirect volumetric scattering pass"
msgstr "傳遞間接體積散射通道"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_majorant
#: scripts/addons_core/cycles/engine.py:219
msgid "Volume Majorant"
msgstr "體積上限值"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_majorant
msgid "Majorant transmittance of the volume"
msgstr "體積的上限透射率"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_scatter
msgid "Contribution of paths that scattered in the volume at the primary ray"
msgstr "主射線在體積內發生散射的路徑的貢獻"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_transmit
#: scripts/addons_core/cycles/engine.py:218
msgid "Volume Transmit"
msgstr "體積透射"

#. :src: bpy.types.CyclesRenderLayerSettings.use_pass_volume_transmit
msgid ""
"Contribution of paths that transmitted through the volume at the primary ray"
msgstr "在主射線下透過體積傳播路徑的貢獻"

#. :src: bpy.types.CyclesRenderSettings.adaptive_min_samples
#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_min_samples
msgid "Adaptive Min Samples"
msgstr "自適應最小取樣"

#. :src: bpy.types.CyclesRenderSettings.adaptive_min_samples
msgid ""
"Minimum AA samples for adaptive sampling, to discover noisy features before "
"stopping sampling. Zero for automatic setting based on noise threshold"
msgstr "用於自適應取樣的最小AA取樣數，在停止取樣前發現噪點特徵。根據噪點閾值自動設定為0"

#. :src: bpy.types.CyclesRenderSettings.adaptive_threshold
#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_threshold
msgid "Adaptive Sampling Threshold"
msgstr "自適應取樣閾值"

#. :src: bpy.types.CyclesRenderSettings.adaptive_threshold
msgid ""
"Noise level step to stop sampling at, lower values reduce noise at the cost "
"of render time. Zero for automatic setting based on number of AA samples"
msgstr "停止取樣的噪點級別，調低數值會減少噪點，但會延長算繪時間。基於AA取樣數自動設定為0"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces
msgid "AO Bounces"
msgstr "AO反彈"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces
#. :src: bpy.types.CyclesRenderSettings.ao_bounces_render
msgid ""
"After this number of light bounces, use approximate global illumination. 0 "
"disables this feature"
msgstr "在該次數的光反彈後，使用近似的全域性照明。0為禁用此功能"

#. :src: bpy.types.CyclesRenderSettings.ao_bounces_render
msgid "AO Bounces Render"
msgstr "AO反彈算繪"

#. :src: bpy.types.CyclesRenderSettings.auto_scrambling_distance
msgid "Automatic Scrambling Distance"
msgstr "自適應置亂距離"

#. :src: bpy.types.CyclesRenderSettings.auto_scrambling_distance
msgid ""
"Automatically reduce the randomization between pixels to improve GPU "
"rendering performance, at the cost of possible rendering artifacts"
msgstr "自動降低畫素之間的隨機化，以提高GPU算繪效能，但代價是可能會出現算繪瑕疵"

#. :src: bpy.types.CyclesRenderSettings.bake_type
msgid "Type of pass to bake"
msgstr "烘焙通道的型別"

#. :src: bpy.types.CyclesRenderSettings.blur_glossy
msgid "Filter Glossy"
msgstr "濾除光澤"

#. :src: bpy.types.CyclesRenderSettings.blur_glossy
msgid ""
"Adaptively blur glossy shaders and image textures after blurry bounces, to "
"reduce noise and improve texture cache efficiency at the cost of accuracy. "
"Lower this value to render caustics"
msgstr "在模糊反彈後，對光澤著色器和影象紋理進行自適應模糊處理，以減少噪點並提高紋理快取效率，但會犧牲部分精度。降低此數值可算繪焦散"

#. :src: bpy.types.CyclesRenderSettings.camera_cull_margin
msgid "Camera Cull Margin"
msgstr "攝像機剔除邊距"

#. :src: bpy.types.CyclesRenderSettings.camera_cull_margin
msgid "Margin for the camera space culling"
msgstr "攝像機空間剔除的邊距"

#. :src: bpy.types.CyclesRenderSettings.caustics_reflective
msgid "Reflective Caustics"
msgstr "反射焦散"

#. :src: bpy.types.CyclesRenderSettings.caustics_reflective
msgid ""
"Use reflective caustics, resulting in a brighter image (more noise but added"
" realism)"
msgstr "使用反射焦散，影象亮度更高 (噪點多，但更真實)"

#. :src: bpy.types.CyclesRenderSettings.caustics_refractive
msgid "Refractive Caustics"
msgstr "折射焦散"

#. :src: bpy.types.CyclesRenderSettings.caustics_refractive
msgid ""
"Use refractive caustics, resulting in a brighter image (more noise but added"
" realism)"
msgstr "使用折射焦散，影象亮度更高 (噪點多，但更真實)"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout
msgid "BVH Layout"
msgstr "BVH佈局"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout:'BVH2'
msgid "BVH2"
msgstr "BVH2"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_layout:'EMBREE'
msgid "Embree"
msgstr "Embree"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_time_steps
msgid "BVH Time Steps"
msgstr "BVH 時間步幅"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_time_steps
msgid ""
"Split BVH primitives by this number of time steps to speed up render time in"
" cost of memory"
msgstr "按此時間步幅來拆分 BVH 基元，以犧牲記憶體為代價來加快算繪"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type
msgid "Viewport BVH Type"
msgstr "檢視的 BVH 型別"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type
msgid "Choose between faster updates, or faster render"
msgstr "在較快更新速度和較快的算繪速度之間選擇"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'DYNAMIC_BVH'
msgid "Dynamic BVH"
msgstr "動態 BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'DYNAMIC_BVH'
msgid "Objects can be individually updated, at the cost of slower render time"
msgstr "物體可被單獨更新, 但算繪速度較慢"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'STATIC_BVH'
msgid "Static BVH"
msgstr "靜態 BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_bvh_type:'STATIC_BVH'
msgid ""
"Any object modification requires a complete BVH rebuild, but renders faster"
msgstr "物體的修改操作需要一次完整的BVH重建, 但可提升算繪速度"

#. :src: bpy.types.CyclesRenderSettings.debug_texture_cache_preserve_unused
msgid "Preserve Unused MB"
msgstr "保留未使用MB"

#. :src: bpy.types.CyclesRenderSettings.debug_texture_cache_preserve_unused
msgid "Preserve unused texture cache data, up to this amount of memory"
msgstr "保留未使用的紋理快取資料，最多佔用此大小的記憶體"

#. :src: bpy.types.CyclesRenderSettings.debug_use_compact_bvh
msgid "Use Compact BVH"
msgstr "使用緊湊BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_use_compact_bvh
msgid "Use compact BVH structure (uses less ram but renders slower)"
msgstr "使用緊湊BVH結構 (佔用記憶體更少，但算繪更慢)"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cpu_avx2
msgid "AVX2"
msgstr "AVX2"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cpu_sse42
msgid "SSE42"
msgstr "SSE42"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cuda_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_hip_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_metal_adaptive_compile
msgid "Adaptive Compile"
msgstr "自適應編譯"

#. :src: bpy.types.CyclesRenderSettings.debug_use_cuda_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_hip_adaptive_compile
#. :src: bpy.types.CyclesRenderSettings.debug_use_metal_adaptive_compile
msgid ""
"Compile the Cycles GPU kernel with only the feature set required for the "
"current scene"
msgstr "僅編譯當前場景所需的特性集的 Cycles GPU 核心"

#. :src: bpy.types.CyclesRenderSettings.debug_use_hair_bvh
msgid "Use Curves BVH"
msgstr "使用曲線 BVH"

#. :src: bpy.types.CyclesRenderSettings.debug_use_hair_bvh
msgid ""
"Use special type BVH optimized for curves (uses more ram but renders faster)"
msgstr "對曲線使用最佳化過的特殊型別 BVH (佔用更多內，但算繪速度更快)"

#. :src: bpy.types.CyclesRenderSettings.debug_use_optix_debug
msgid "OptiX Module Debug"
msgstr "OptiX模組除錯"

#. :src: bpy.types.CyclesRenderSettings.debug_use_optix_debug
msgid ""
"Load OptiX module in debug mode: lower logging verbosity level, enable "
"validations, and lower optimization level"
msgstr "以除錯模式載入 OptiX 模組：調低日誌冗餘級別，啟用驗證，並且調低最佳化級別"

#. :src: bpy.types.CyclesRenderSettings.debug_use_spatial_splits
msgid "Use Spatial Splits"
msgstr "使用空間分離"

#. :src: bpy.types.CyclesRenderSettings.debug_use_spatial_splits
msgid "Use BVH spatial splits: longer builder time, faster render"
msgstr "使用 BVH 空間分裂: 建立時間較長, 但算繪速度較快"

#. :src: bpy.types.CyclesRenderSettings.debug_use_texture_cache_eviction
msgid "Cache Eviction"
msgstr "快取驅逐"

#. :src: bpy.types.CyclesRenderSettings.debug_use_texture_cache_eviction
msgid "Evict unused tiles from the texture cache to free up memory"
msgstr "從紋理快取中移除未使用的分塊以釋放記憶體"

#. :src: bpy.types.CyclesRenderSettings.denoiser
#: scripts/addons_core/cycles/ui.py:276 scripts/addons_core/cycles/ui.py:361
msgid "Denoiser"
msgstr "降噪器"

#. :src: bpy.types.CyclesRenderSettings.denoiser
msgid ""
"Denoise the image with the selected denoiser. For denoising the image after "
"rendering"
msgstr "使用所選降噪器為影象降噪。在算繪後對影象降噪"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes
msgid "Denoising Input Passes"
msgstr "輸入通道降噪"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes
msgid ""
"Passes used by the denoiser to distinguish noise from shader and geometry "
"detail"
msgstr "供降噪器區分著色器和幾何細節產生的噪點的通道"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB'
msgid "Do not use utility passes for denoising"
msgstr "不將功能通道用於降噪"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO'
#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:76
msgid "Albedo"
msgstr "反照率"

#. :src: bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO'
#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO'
msgid "Use albedo pass for denoising"
msgstr "將反照通道用於降噪"

#. :src:
#. bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO_NORMAL'
#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO_NORMAL'
msgid "Albedo and Normal"
msgstr "反照率與法向"

#. :src:
#. bpy.types.CyclesRenderSettings.denoising_input_passes:'RGB_ALBEDO_NORMAL'
#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_input_passes:'RGB_ALBEDO_NORMAL'
msgid "Use albedo and normal passes for denoising"
msgstr "將反照率與法向通道用於降噪"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter
msgid "Denoising Prefilter"
msgstr "降噪預過濾"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter
msgid ""
"Prefilter noisy guiding (albedo and normal) passes to improve denoising "
"quality when using OpenImageDenoise"
msgstr "預過濾嘈雜的引導通道 (反照和法向)，以提高使用 OpenImageDenoise 時的降噪質量"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'NONE'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'NONE'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:34
msgid "No prefiltering, use when guiding passes are noise-free"
msgstr "無預過濾，當引導通道無噪點時使用"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'FAST'
msgid ""
"Denoise color and guiding passes together. Improves quality when guiding "
"passes are noisy using least amount of extra processing time"
msgstr "顏色和引導通道一起降噪。當引導通道有噪點時，使用最少的額外處理時間，提高質量"

#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'ACCURATE'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'ACCURATE'
msgid ""
"Prefilter noisy guiding passes before denoising color. Improves quality when"
" guiding passes are noisy using extra processing time"
msgstr "在顏色降噪之前，預過濾嘈雜的引導通道。當引導通道有噪點時，使用額外的處理時間，提高質量"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality
msgid "Denoising Quality"
msgstr "降噪品質"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality
msgid "Overall denoising quality when using OpenImageDenoise"
msgstr "當使用OpenImageDenoise時的總體降噪品質"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'HIGH'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'HIGH'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'HIGH'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'HIGH'
msgid "High quality"
msgstr "高品質"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'BALANCED'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'BALANCED'
#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'BALANCED'
#. :src:
#. bpy.types.RenderSettings.compositor_denoise_preview_quality:'BALANCED'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:59
msgid "Balanced"
msgstr "均衡"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'BALANCED'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'BALANCED'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'BALANCED'
#. :src:
#. bpy.types.RenderSettings.compositor_denoise_preview_quality:'BALANCED'
#: source/blender/nodes/composite/nodes/node_composite_denoise.cc:60
msgid "Balanced between performance and quality"
msgstr "兼顧效能和品質"

#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'FAST'
msgid "High performance"
msgstr "高效能"

#. :src: bpy.types.CyclesRenderSettings.denoising_use_gpu
msgid "Denoise on GPU"
msgstr "GPU 降噪"

#. :src: bpy.types.CyclesRenderSettings.denoising_use_gpu
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_use_gpu
msgid ""
"Perform denoising on GPU devices configured in the system tab in the user "
"preferences. This is significantly faster than on CPU, but requires "
"additional GPU memory. When large scenes need more GPU memory, this option "
"can be disabled"
msgstr ""
"在偏好設定中的 “系統” "
"選項卡中配置的GPU裝置執行降噪，這明顯快於CPU，但需要額外的GPU視訊記憶體。當大型場景需要更多視訊記憶體時，可以禁用此選項"

#. :src: bpy.types.CyclesRenderSettings.device
msgid "Device to use for rendering"
msgstr "用於算繪的裝置"

#. :src: bpy.types.CyclesRenderSettings.device:'CPU'
msgid "Use CPU for rendering"
msgstr "使用 CPU 進行算繪"

#. :src: bpy.types.CyclesRenderSettings.device:'GPU'
msgid "GPU Compute"
msgstr "GPU 計算"

#. :src: bpy.types.CyclesRenderSettings.device:'GPU'
msgid ""
"Use GPU compute device for rendering, configured in the system tab in the "
"user preferences"
msgstr "使用 GPU 計算裝置進行算繪, 在使用者偏好設定的系統面板中進行配置"

#. :src: bpy.types.CyclesRenderSettings.dicing_camera
msgid "Dicing Camera"
msgstr "切分用攝像機"

#. :src: bpy.types.CyclesRenderSettings.dicing_camera
msgid ""
"Camera to use as reference point when subdividing geometry, useful to avoid "
"crawling artifacts in animations when the scene camera is moving"
msgstr "在細分幾何體時用作參考點的攝像機，當場景攝像機移動時，對於避免動畫中的爬行偽影非常有用"

#. :src: bpy.types.CyclesRenderSettings.dicing_rate
msgid "Dicing Rate"
msgstr "切分率"

#. :src: bpy.types.CyclesRenderSettings.dicing_rate
msgid "Multiplier for per object adaptive subdivision size"
msgstr "基於每個物體的自適應細分大小的倍增器"

#. :src: bpy.types.CyclesRenderSettings.diffuse_bounces
#. :src: bpy.types.SceneEEVEE.gi_diffuse_bounces
msgid "Diffuse Bounces"
msgstr "漫射反彈"

#. :src: bpy.types.CyclesRenderSettings.diffuse_bounces
msgid "Maximum number of diffuse reflection bounces, bounded by total maximum"
msgstr "最大漫反射反彈次數, 按最大值總數執行反彈"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type
msgid "Direct Light Sampling"
msgstr "直接光采樣"

#. :src: bpy.types.CyclesRenderSettings.direct_light_sampling_type
msgid "The type of strategy used for sampling direct light contributions"
msgstr "用於取樣直接光貢獻策略型別"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'MULTIPLE_IMPORTANCE_SAMPLING'
msgid "Multiple Importance Sampling"
msgstr "多重重要性取樣"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'MULTIPLE_IMPORTANCE_SAMPLING'
msgid ""
"Multiple importance sampling is used to combine direct light contributions "
"from next-event estimation and forward path tracing"
msgstr "多重重要性取樣用於將來自下一事件估算和前向路徑跟蹤的直接光貢獻結合起來"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'FORWARD_PATH_TRACING'
msgid "Forward Path Tracing"
msgstr "前向路徑跟蹤"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'FORWARD_PATH_TRACING'
msgid "Direct light contributions are only sampled using forward path tracing"
msgstr "僅使用前向路徑跟蹤取樣直接光貢獻"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'NEXT_EVENT_ESTIMATION'
msgid "Next-Event Estimation"
msgstr "下一事件估算"

#. :src:
#. bpy.types.CyclesRenderSettings.direct_light_sampling_type:'NEXT_EVENT_ESTIMATION'
msgid ""
"Direct light contributions are only sampled using next-event estimation"
msgstr "僅使用下一事件估算取樣直接光貢獻"

#. :src: bpy.types.CyclesRenderSettings.distance_cull_margin
msgid "Cull Distance"
msgstr "剔除距離"

#. :src: bpy.types.CyclesRenderSettings.distance_cull_margin
msgid "Cull objects which are further away from camera than this distance"
msgstr "剔除遠離攝像機超過此距離的物體"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method
msgid "Fast GI Method"
msgstr "快速 GI 方法"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method
#. :src: bpy.types.SceneEEVEE.fast_gi_method
msgid "Fast GI approximation method"
msgstr "快速 GI 近似法"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method:'REPLACE'
msgid ""
"Replace global illumination with ambient occlusion after a specified number "
"of bounces"
msgstr "在指定的反彈次數後，用環境光遮蔽替換全域性照明"

#. :src: bpy.types.CyclesRenderSettings.fast_gi_method:'ADD'
msgid "Add ambient occlusion to diffuse surfaces"
msgstr "向漫射表面新增環境光遮蔽"

#. :src: bpy.types.CyclesRenderSettings.film_exposure
msgid "Image brightness scale"
msgstr "影象亮度比"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_glass
#: scripts/addons_core/cycles/ui.py:829
msgid "Transparent Glass"
msgstr "透明玻璃"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_glass
msgid ""
"Render transmissive surfaces as transparent, for compositing glass over "
"another background"
msgstr "使透射表面呈透明，用於將透明玻璃合成到另一個背景上"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_roughness
msgid "Transparent Roughness Threshold"
msgstr "透明糙度閾值"

#. :src: bpy.types.CyclesRenderSettings.film_transparent_roughness
msgid ""
"For transparent transmission, keep surfaces with roughness above the "
"threshold opaque"
msgstr "對於透明效果，使高於不透明閾值的表面保持粗糙"

#. :src: bpy.types.CyclesRenderSettings.filter_width
msgid "Pixel filter width"
msgstr "畫素過濾寬度"

#. :src: bpy.types.CyclesRenderSettings.glossy_bounces
msgid "Glossy Bounces"
msgstr "光澤反彈"

#. :src: bpy.types.CyclesRenderSettings.glossy_bounces
msgid "Maximum number of glossy reflection bounces, bounded by total maximum"
msgstr "最大高光反射反彈次數, 按最大總數執行反彈"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type
#: scripts/addons_core/cycles/ui.py:441
msgid "Directional Sampling Type"
msgstr "定向取樣型別"

#. :src: bpy.types.CyclesRenderSettings.guiding_directional_sampling_type
msgid "Type of the directional sampling used for guiding"
msgstr "用於引導的定向取樣型別"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'MIS'
msgid "Diffuse Product MIS"
msgstr "漫反射乘積 MIS"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'MIS'
msgid ""
"Guided diffuse BSDF component based on the incoming light distribution and "
"the cosine product (closed form product)"
msgstr "基於入射光分佈和餘弦乘積（閉合形式乘積），指引漫反射BSDF元件"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'RIS'
msgid "Re-sampled Importance Sampling"
msgstr "重取樣重要的取樣"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'RIS'
msgid ""
"Perform RIS sampling to guided based on the product of the incoming light "
"distribution and the BSDF"
msgstr "根據入射光分佈和BSDF的乘積進行RIS取樣引導"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'ROUGHNESS'
msgid "Roughness-based"
msgstr "基於粗糙度"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_directional_sampling_type:'ROUGHNESS'
msgid ""
"Adjust the guiding probability based on the roughness of the material "
"components"
msgstr "根據材質元件的粗糙度調整引導機率"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type
msgid "Guiding Distribution Type"
msgstr "引導分佈型別"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type
msgid "Type of representation for the guiding distribution"
msgstr "引導分佈的表示型別"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_distribution_type:'PARALLAX_AWARE_VMM'
msgid "Parallax-Aware VMM"
msgstr "Parallax-Aware VMM"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_distribution_type:'PARALLAX_AWARE_VMM'
msgid "Use Parallax-aware von Mises-Fisher models as directional distribution"
msgstr "使用 Parallax-aware von Mises-Fisher 模型作為定向分佈"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_distribution_type:'DIRECTIONAL_QUAD_TREE'
msgid "Directional Quad Tree"
msgstr "定向四叉樹"

#. :src:
#. bpy.types.CyclesRenderSettings.guiding_distribution_type:'DIRECTIONAL_QUAD_TREE'
msgid "Use Directional Quad Trees as directional distribution"
msgstr "使用定向四叉樹作為定向分佈"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'VMM'
msgid "VMM"
msgstr "VMM"

#. :src: bpy.types.CyclesRenderSettings.guiding_distribution_type:'VMM'
msgid "Use von Mises-Fisher models as directional distribution"
msgstr "使用 von Mises-Fisher 模型作為定向分佈"

#. :src: bpy.types.CyclesRenderSettings.guiding_roughness_threshold
msgid "Guiding Roughness Threshold"
msgstr "導向糙度閾值"

#. :src: bpy.types.CyclesRenderSettings.guiding_roughness_threshold
msgid "The minimal roughness value of a material to apply guiding"
msgstr "應用於引導的材質的最小粗糙度值"

#. :src: bpy.types.CyclesRenderSettings.guiding_training_samples
msgid "Training Samples"
msgstr "訓練取樣"

#. :src: bpy.types.CyclesRenderSettings.guiding_training_samples
msgid ""
"The maximum number of samples used for training path guiding. Higher samples"
" lead to more accurate guiding, however may also unnecessarily slow down "
"rendering once guiding is accurate enough. A value of 0 will continue "
"training until the last sample"
msgstr ""
"用於訓練路徑引導的最大采樣數。取樣數越高，引導越準確，然而一旦引導足夠精確，也可能不必要地拖累算繪速度。值為 0 將持續訓練直至最後一個取樣"

#. :src: bpy.types.CyclesRenderSettings.light_sampling_threshold
msgid "Light Sampling Threshold"
msgstr "燈光采樣閾值"

#. :src: bpy.types.CyclesRenderSettings.light_sampling_threshold
msgid ""
"Probabilistically terminate light samples when the light contribution is "
"below this threshold (more noise but faster rendering). Zero disables the "
"test and never ignores lights"
msgstr "當光貢獻低於此閾值 (噪點較多但算繪速度更快) 時，可終止取樣。零表示禁用測試，從不忽略燈光"

#. :src: bpy.types.CyclesRenderSettings.max_bounces
msgid "Total maximum number of bounces"
msgstr "總反彈最大值"

#. :src: bpy.types.CyclesRenderSettings.max_subdivisions
msgid "Max Subdivisions"
msgstr "最大細分"

#. :src: bpy.types.CyclesRenderSettings.max_subdivisions
msgid ""
"Stop subdividing when this level is reached even if the dicing rate would "
"produce finer tessellation"
msgstr "達到此級別時停止細分，即使切分率會產生更精細的鑲嵌細分"

#. :src: bpy.types.CyclesRenderSettings.min_light_bounces
msgid "Min Light Bounces"
msgstr "最小光線反彈"

#. :src: bpy.types.CyclesRenderSettings.min_light_bounces
msgid ""
"Minimum number of light bounces. Setting this higher reduces noise in the "
"first bounces, but can also be less efficient for more complex geometry like"
" curves and volumes"
msgstr "光線反彈的最小次數。設定較高的數值可降低第一次反彈時的噪波，但對於曲線和體積等更復雜的幾何形狀，效率也會降低"

#. :src: bpy.types.CyclesRenderSettings.min_transparent_bounces
msgid "Min Transparent Bounces"
msgstr "最小透明反彈"

#. :src: bpy.types.CyclesRenderSettings.min_transparent_bounces
msgid ""
"Minimum number of transparent bounces. Setting this higher reduces noise in "
"the first bounces, but can also be less efficient for more complex geometry "
"like curves and volumes"
msgstr "透明反彈的最小次數。設定較高的數值可降低第一次反彈時的噪波，但對於曲線和體積等更復雜的幾何形狀，效率也會降低"

#. :src: bpy.types.CyclesRenderSettings.offscreen_dicing_scale
msgid "Offscreen Dicing Scale"
msgstr "畫面以外的切割比例"

#. :src: bpy.types.CyclesRenderSettings.offscreen_dicing_scale
msgid ""
"Multiplier for dicing rate of geometry outside of the camera view. The "
"dicing rate of objects is gradually increased the further they are outside "
"the camera view. Lower values provide higher quality reflections and shadows"
" for off screen objects, while higher values use less memory"
msgstr ""
"用於攝像機檢視外幾何的切分率的乘數。物體的切分率會隨著物體在攝像機檢視之外的進一步增加而逐漸增加。值越低，螢幕外物件提供更高質量的反射和陰影，而較高的值則使用更少的記憶體"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type
msgid "Pixel filter type"
msgstr "畫素過濾型別"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BOX'
msgid "Box filter"
msgstr "方形過濾"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'GAUSSIAN'
msgid "Gaussian filter"
msgstr "高斯過濾"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BLACKMAN_HARRIS'
msgid "Blackman-Harris"
msgstr "布萊克曼-哈里斯"

#. :src: bpy.types.CyclesRenderSettings.pixel_filter_type:'BLACKMAN_HARRIS'
msgid "Blackman-Harris filter"
msgstr "布萊克曼-哈里斯過濾"

#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_min_samples
msgid ""
"Minimum AA samples for adaptive sampling, to discover noisy features before "
"stopping sampling. Zero for automatic setting based on noise threshold, for "
"viewport renders"
msgstr "用於自適應取樣的最小AA取樣數，在停止取樣前發現噪點特徵。基於噪點閾值自動設定為0，用於檢視算繪"

#. :src: bpy.types.CyclesRenderSettings.preview_adaptive_threshold
msgid ""
"Noise level step to stop sampling at, lower values reduce noise at the cost "
"of render time. Zero for automatic setting based on number of AA samples, "
"for viewport renders"
msgstr "停止取樣的噪點級別，調低數值會減少噪點，但會延長算繪時間。基於AA取樣數自動設定為0，用於檢視算繪"

#. :src: bpy.types.CyclesRenderSettings.preview_denoiser
msgid "Viewport Denoiser"
msgstr "檢視降噪器"

#. :src: bpy.types.CyclesRenderSettings.preview_denoiser
msgid "Denoise the image after each preview update with the selected denoiser"
msgstr "使用所選降噪器在每次預覽更新後為影象降噪"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_input_passes
msgid "Viewport Denoising Input Passes"
msgstr "檢視輸入通道降噪"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter
msgid "Viewport Denoising Prefilter"
msgstr "檢視降噪預過濾"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality
msgid "Viewport Denoising Quality"
msgstr "檢視降噪品質"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_start_sample
msgid "Start Denoising"
msgstr "降噪起點"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_start_sample
msgid "Sample to start denoising the preview at"
msgstr "用於開始對預覽降噪的取樣點"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality
msgid "Viewport Denoising Upscale Quality"
msgstr "檢視降噪放大品質"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality
msgid "Overall upscale factor and denoising quality when using DLSS"
msgstr "使用 DLSS 時的整體放大係數和降噪質量"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'NONE'
msgid "Highest quality without upscaling"
msgstr "無放大的最高質量"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'QUALITY'
msgid "Offers higher image quality than balanced mode"
msgstr "比均衡模式更高的影象質量"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'BALANCED'
msgid "Offers both optimized performance and image quality"
msgstr "既提供最佳化的效能，又保證影象質量"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'PERFORMANCE'
msgid "Offers a higher performance boost than balanced mode"
msgstr "相比於均衡模式，效能提升更顯著"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'ULTRA_PERFORMANCE'
msgid "Ultra Performance"
msgstr "極致效能"

#. :src:
#. bpy.types.CyclesRenderSettings.preview_denoising_upscale_quality:'ULTRA_PERFORMANCE'
msgid "Offers the highest performance boost"
msgstr "提供最大的效能提升"

#. :src: bpy.types.CyclesRenderSettings.preview_denoising_use_gpu
msgid "Denoise Preview on GPU"
msgstr "GPU 預覽降噪"

#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Viewport Dicing Rate"
msgstr "檢視切分率"

#. :src: bpy.types.CyclesRenderSettings.preview_dicing_rate
msgid "Multiplier for per object adaptive subdivision size in the viewport"
msgstr "基於每個物體的視口中自適應細分大小的倍增器"

#. :src: bpy.types.CyclesRenderSettings.preview_pause
msgid "Pause Preview"
msgstr "暫停預覽"

#. :src: bpy.types.CyclesRenderSettings.preview_pause
msgid ""
"Deprecated, this has no effect anymore. Use RegionView3D.pause_render "
"instead"
msgstr "已棄用，不再生效。以 RegionView3D.pause_render 代替"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
#. :src: bpy.types.SceneEEVEE.taa_samples
msgid "Viewport Samples"
msgstr "檢視取樣"

#. :src: bpy.types.CyclesRenderSettings.preview_samples
msgid "Number of samples to render in the viewport, unlimited if 0"
msgstr "在檢視內算繪時的取樣次數, 0 為無限取樣"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid "Scrambling Distance viewport"
msgstr "置亂距離檢視"

#. :src: bpy.types.CyclesRenderSettings.preview_scrambling_distance
msgid ""
"Uses the Scrambling Distance value for the viewport. Faster but may flicker"
msgstr "對檢視使用置亂距離。更快，但可能會閃爍"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_duration
msgid "Rolling Shutter Duration"
msgstr "捲簾快門持續時間"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_duration
msgid "Scanline \"exposure\" time for the rolling shutter effect"
msgstr "滾動快門效果的掃描線 \"曝光\" 時間"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type
msgid "Shutter Type"
msgstr "快門型別"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type
msgid "Type of rolling shutter effect matching CMOS-based cameras"
msgstr "匹配於CMOS的攝像機的滾動快門效果機型別"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type:'NONE'
msgid "No rolling shutter effect used"
msgstr "不使用捲簾快門效果"

#. :src: bpy.types.CyclesRenderSettings.rolling_shutter_type:'TOP'
msgid "Sensor is being scanned from top to bottom"
msgstr "正在從上到下掃描感測器"

#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid ""
"If non-zero, the maximum value for a direct sample, higher values will be "
"scaled down to avoid too much noise and slow convergence at the cost of "
"accuracy"
msgstr "若為非零值, 則代表取樣最大值, 較高的值將被按比例縮小, 以避免產生過多的噪點以及緩慢的聚斂, 以犧牲精確度為代價"

#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid ""
"If non-zero, the maximum value for an indirect sample, higher values will be"
" scaled down to avoid too much noise and slow convergence at the cost of "
"accuracy"
msgstr "若為非零值, 則代表間接光采樣最大值, 較高的值將被按比例縮小, 以避免產生過多的噪點以及緩慢的聚斂, 以犧牲精確度為代價"

#. :src: bpy.types.CyclesRenderSettings.sample_offset
msgid "Sample Subset Offset"
msgstr "取樣子集偏移"

#. :src: bpy.types.CyclesRenderSettings.sample_offset
msgid "0-based index of sample to start rendering from"
msgstr "從 0 開始算繪的取樣索引"

#. :src: bpy.types.CyclesRenderSettings.sample_subset_length
msgid "Sample Subset Length"
msgstr "取樣子集長度"

#. :src: bpy.types.CyclesRenderSettings.sample_subset_length
msgid "The number of samples to render in this subset"
msgstr "此子集中要算繪的取樣數"

#. :src: bpy.types.CyclesRenderSettings.samples
msgid "Number of samples to render for each pixel"
msgstr "各畫素的算繪取樣次數"

#. :src: bpy.types.CyclesRenderSettings.sampling_pattern
msgid "Sampling Pattern"
msgstr "取樣模式"

#. :src: bpy.types.CyclesRenderSettings.sampling_pattern
msgid "Random sampling pattern used by the integrator"
msgstr "積分器使用的隨機取樣模式"

#. :src: bpy.types.CyclesRenderSettings.scrambling_distance
#: scripts/addons_core/cycles/ui.py:484
msgid "Scrambling Distance"
msgstr "置亂距離"

#. :src: bpy.types.CyclesRenderSettings.scrambling_distance
msgid ""
"Reduce randomization between pixels to improve GPU rendering performance, at"
" the cost of possible rendering artifacts if set too low"
msgstr "降低畫素之間的隨機化以提高GPU算繪效能，但代價是如果設定得太低，可能會出現算繪瑕疵"

#. :src: bpy.types.CyclesRenderSettings.seed
msgid "Seed value for integrator to get different noise patterns"
msgstr "積分器的隨機種值, 用於獲得不同效果的噪點"

#. :src: bpy.types.CyclesRenderSettings.shading_system
msgid "Use Open Shading Language"
msgstr "使用開放式著色語言"

#. :src: bpy.types.CyclesRenderSettings.surface_guiding_probability
msgid "Surface Guiding Probability"
msgstr "表面引導機率"

#. :src: bpy.types.CyclesRenderSettings.surface_guiding_probability
msgid "The probability of guiding a direction on a surface"
msgstr "在表面上引導某個方向的機率"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Viewport Texture Limit"
msgstr "檢視紋理限制"

#. :src: bpy.types.CyclesRenderSettings.texture_limit
msgid "Limit texture size used by viewport rendering"
msgstr "限制檢視算繪所使用的紋理尺寸"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'OFF'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'OFF'
msgid "No Limit"
msgstr "無限制"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'OFF'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'OFF'
msgid "No texture size limit"
msgstr "無紋理尺寸限制"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'128'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'128'
msgid "Limit texture size to 128 pixels"
msgstr "限制紋理尺寸為 128 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'256'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'256'
msgid "Limit texture size to 256 pixels"
msgstr "限制紋理尺寸為 256 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'512'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'512'
msgid "Limit texture size to 512 pixels"
msgstr "限制紋理尺寸為 512 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'1024'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'1024'
msgid "Limit texture size to 1024 pixels"
msgstr "限制紋理尺寸為 1024 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'2048'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'2048'
msgid "Limit texture size to 2048 pixels"
msgstr "限制紋理尺寸為 2048 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'4096'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'4096'
msgid "Limit texture size to 4096 pixels"
msgstr "限制紋理尺寸為 4096 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit:'8192'
#. :src: bpy.types.CyclesRenderSettings.texture_limit_render:'8192'
msgid "Limit texture size to 8192 pixels"
msgstr "限制紋理尺寸為 8192 畫素"

#. :src: bpy.types.CyclesRenderSettings.texture_limit_render
msgid "Render Texture Limit"
msgstr "算繪紋理限制"

#. :src: bpy.types.CyclesRenderSettings.texture_limit_render
msgid "Limit texture size used by final rendering"
msgstr "限制最終算繪所使用的紋理尺寸"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Viewport Texture Resolution"
msgstr "檢視紋理解析度"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution
msgid "Scale factor for texture resolution used by viewport rendering"
msgstr "檢視算繪中用於紋理解析度的縮放係數"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution_render
msgid "Render Texture Resolution"
msgstr "算繪紋理解析度"

#. :src: bpy.types.CyclesRenderSettings.texture_resolution_render
msgid "Scale factor for texture resolution used by final rendering"
msgstr "最終算繪中用於紋理解析度的縮放係數"

#. :src: bpy.types.CyclesRenderSettings.tile_size
msgid "Tile Size"
msgstr "平鋪尺寸"

#. :src: bpy.types.CyclesRenderSettings.tile_size
msgid ""
"Render high resolution images in tiles of this size, to reduce memory usage."
" Tiles are cached to disk while rendering to save memory"
msgstr "使用此分塊大小來算繪高解析度的影象，以降低記憶體佔用。算繪時分塊將快取至磁碟以節約記憶體"

#. :src: bpy.types.CyclesRenderSettings.time_limit
msgid ""
"Limit the render time (excluding synchronization time). Zero disables the "
"limit"
msgstr "限制算繪時間 (同步時間不包括在內)，0為禁用該限制"

#. :src: bpy.types.CyclesRenderSettings.transmission_bounces
msgid "Transmission Bounces"
msgstr "透射反彈"

#. :src: bpy.types.CyclesRenderSettings.transmission_bounces
msgid "Maximum number of transmission bounces, bounded by total maximum"
msgstr "最大透射反彈次數, 按最大值總數執行反彈"

#. :src: bpy.types.CyclesRenderSettings.transparent_max_bounces
msgid "Transparent Max Bounces"
msgstr "透明反彈次數上限"

#. :src: bpy.types.CyclesRenderSettings.transparent_max_bounces
msgid ""
"Maximum number of transparent bounces. This is independent of maximum number"
" of other bounces"
msgstr "透明反彈的最大次數。該設定獨立於其他反彈的最大次數"

#. :src: bpy.types.CyclesRenderSettings.use_adaptive_sampling
#. :src: bpy.types.CyclesRenderSettings.use_preview_adaptive_sampling
msgid "Use Adaptive Sampling"
msgstr "使用自適應取樣"

#. :src: bpy.types.CyclesRenderSettings.use_adaptive_sampling
msgid ""
"Automatically reduce the number of samples per pixel based on estimated "
"noise level"
msgstr "基於估計的噪波級別自動減少每個畫素的取樣數"

#. :src: bpy.types.CyclesRenderSettings.use_animated_seed
msgid "Use Animated Seed"
msgstr "使用動畫隨機種"

#. :src: bpy.types.CyclesRenderSettings.use_animated_seed
msgid ""
"Use different seed values (and hence noise patterns) at different frames"
msgstr "在不同的幀使用不同的種子值 (以及噪點模式)"

#. :src: bpy.types.CyclesRenderSettings.use_auto_tile
msgid "Auto Tile"
msgstr "自動分塊"

#. :src: bpy.types.CyclesRenderSettings.use_auto_tile
msgid "Deprecated, tiling is always enabled"
msgstr "已棄用，分塊始終處於啟用狀態"

#. :src: bpy.types.CyclesRenderSettings.use_camera_cull
msgid "Allow objects to be culled based on the camera frustum"
msgstr "允許基於攝像機的視錐體剔除物體"

#. :src: bpy.types.CyclesRenderSettings.use_deterministic_guiding
msgid "Deterministic"
msgstr "確定性"

#. :src: bpy.types.CyclesRenderSettings.use_deterministic_guiding
msgid ""
"Makes path guiding deterministic which means renderings will be reproducible"
" with the same pixel values every time. This feature slows down training"
msgstr "使路徑引導確定，這意味著每次都可以使用相同的畫素值再現算繪。此功能會減慢訓練速度"

#. :src: bpy.types.CyclesRenderSettings.use_distance_cull
msgid "Allow objects to be culled based on the distance from camera"
msgstr "允許基於與攝像機間的距離剔除物體"

#. :src: bpy.types.CyclesRenderSettings.use_fast_gi
msgid ""
"Approximate diffuse indirect light with background tinted ambient occlusion."
" This provides fast alternative to full global illumination, for interactive"
" viewport rendering or final renders with reduced quality"
msgstr "近似帶有背景染色環境光遮蔽的漫射間接光。這提供了全域性照明的快速替代方案，用於犧牲質量的互動式檢視算繪或最終算繪"

#. :src: bpy.types.CyclesRenderSettings.use_guiding
msgid "Guiding"
msgstr "引導"

#. :src: bpy.types.CyclesRenderSettings.use_guiding
msgid ""
"Use path guiding for sampling paths. Path guiding incrementally learns the "
"light distribution of the scene and guides path into directions with high "
"direct and indirect light contributions"
msgstr "對取樣路徑使用路徑引導。路徑引導以增量方式學習場景的光分佈，並將路徑引導到具有高直接和間接光貢獻的方向"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_direct_light
msgid "Guide Direct Light"
msgstr "引導直射光"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_direct_light
msgid ""
"Consider the contribution of directly visible light sources during guiding"
msgstr "在引導過程中考慮直接可見光源的貢獻"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_mis_weights
msgid "Use MIS Weights"
msgstr "使用MIS權重"

#. :src: bpy.types.CyclesRenderSettings.use_guiding_mis_weights
msgid ""
"Use the MIS weight to weight the contribution of directly visible light "
"sources during guiding"
msgstr "使用MIS權重在引導過程中對直接可見光源的貢獻進行加權"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples
msgid "Layer Samples"
msgstr "層取樣"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples
msgid "How to use per view layer sample settings"
msgstr "如何使用單檢視層取樣方式設定"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'USE'
msgid "Per render layer number of samples override scene samples"
msgstr "使用單算繪層取樣次數代替場景取樣次數"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'BOUNDED'
msgid "Bounded"
msgstr "限界"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'BOUNDED'
msgid "Bound per render layer number of samples by global samples"
msgstr "對單算繪層應用全域性取樣次數"

#. :src: bpy.types.CyclesRenderSettings.use_layer_samples:'IGNORE'
msgid "Ignore per render layer number of samples"
msgstr "忽略各算繪層的取樣數值"

#. :src: bpy.types.CyclesRenderSettings.use_light_tree
msgid "Light Tree"
msgstr "燈光樹"

#. :src: bpy.types.CyclesRenderSettings.use_light_tree
msgid ""
"Sample multiple lights more efficiently based on estimated contribution at "
"every shading point"
msgstr "根據在每個陰影點的預估貢獻更有效地對多個光源進行取樣"

#. :src: bpy.types.CyclesRenderSettings.use_pixel_jitter
msgid "Use Pixel Jitter"
msgstr "使用畫素抖動"

#. :src: bpy.types.CyclesRenderSettings.use_preview_adaptive_sampling
msgid ""
"Automatically reduce the number of samples per pixel based on estimated "
"noise level, for viewport renders"
msgstr "基於估計的噪波級別自動減少每個畫素的取樣數，用於檢視算繪"

#. :src: bpy.types.CyclesRenderSettings.use_preview_denoising
msgid "Use Viewport Denoising"
msgstr "使用檢視降噪"

#. :src: bpy.types.CyclesRenderSettings.use_preview_denoising
msgid "Denoise the image in the 3D viewport"
msgstr "在3D檢視中使用影象降噪"

#. :src: bpy.types.CyclesRenderSettings.use_sample_subset
msgid "Use Sample Subset"
msgstr "使用取樣子集"

#. :src: bpy.types.CyclesRenderSettings.use_sample_subset
msgid ""
"Render a subset of the specified max samples. Typically used for distributed"
" rendering across multiple devices"
msgstr "使用指定的最大采樣數的子集。通常用於在跨多裝置間的分散式算繪"

#. :src: bpy.types.CyclesRenderSettings.use_surface_guiding
msgid "Surface Guiding"
msgstr "表面引導"

#. :src: bpy.types.CyclesRenderSettings.use_surface_guiding
msgid "Use guiding when sampling directions on a surface"
msgstr "在表面上取樣方向時使用引導"

#. :src: bpy.types.CyclesRenderSettings.use_volume_guiding
msgid "Volume Guiding"
msgstr "體積引導"

#. :src: bpy.types.CyclesRenderSettings.use_volume_guiding
msgid "Use guiding when sampling directions inside a volume"
msgstr "在體積內取樣方向時使用引導"

# rblc
#. :src: bpy.types.CyclesRenderSettings.volume_biased
#: scripts/addons_core/cycles/ui.py:617
msgid "Biased"
msgstr "有偏"

#. :src: bpy.types.CyclesRenderSettings.volume_biased
msgid ""
"Default volume rendering uses null scattering, which is unbiased and has "
"less artifacts, but could be noisier. Biased option uses ray marching, with "
"controls for steps size and max steps"
msgstr "預設的體積算繪使用零散射方法，該方法無偏且瑕疵更少，但可能噪點更多。“有偏”選項則使用光線步進法，並提供了步長與最大步數的控制"

#. :src: bpy.types.CyclesRenderSettings.volume_bounces
msgid "Volume Bounces"
msgstr "體積反彈次數"

#. :src: bpy.types.CyclesRenderSettings.volume_bounces
msgid "Maximum number of volumetric scattering events"
msgstr "體積散射事件的最大值"

#. :src: bpy.types.CyclesRenderSettings.volume_guiding_probability
msgid "Volume Guiding Probability"
msgstr "體積引導機率"

#. :src: bpy.types.CyclesRenderSettings.volume_guiding_probability
msgid "The probability of guiding a direction inside a volume"
msgstr "在體積內引導某個方向的機率"

#. :src: bpy.types.CyclesRenderSettings.volume_max_steps
#: scripts/addons_core/cycles/ui.py:622
msgid "Max Steps"
msgstr "最大步數"

#. :src: bpy.types.CyclesRenderSettings.volume_max_steps
msgid ""
"Maximum number of steps through the volume before giving up, to avoid "
"extremely long render times with big objects or small step sizes"
msgstr "在放棄之前穿越體積的最大步數，用以避免因物體過大或步長過小而導致極長的算繪時間"

#. :src: bpy.types.CyclesRenderSettings.volume_preview_step_rate
#. :src: bpy.types.CyclesRenderSettings.volume_step_rate
msgid ""
"Globally adjust detail for volume rendering, on top of automatically "
"estimated step size. Higher values reduce render time, lower values render "
"with more detail"
msgstr "在自動估算的步長基礎上，全域性調節體積算繪的細節精度。較高的值會降低算繪時間，較低的值則會算繪出更多細節"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass
msgid "Render pass to show in the 3D Viewport"
msgstr "在3D檢視中顯示的算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'COMBINED'
msgid "Show the Combined Render pass"
msgstr "顯示組合算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'EMISSION'
msgid "Show the Emission render pass"
msgstr "顯示自發光算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'BACKGROUND'
msgid "Show the Background render pass"
msgstr "顯示背景算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'AO'
msgid "Show the Ambient Occlusion render pass"
msgstr "顯示環境光遮蔽算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'SHADOW_CATCHER'
msgid "Show the Shadow Catcher render pass"
msgstr "顯示陰影捕捉算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_diffuse_direct
#. :src: bpy.types.ViewLayer.use_pass_diffuse_direct
#: scripts/addons_core/cycles/engine.py:206
msgid "Diffuse Direct"
msgstr "漫射直接光"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_DIRECT'
msgid "Show the Diffuse Direct render pass"
msgstr "顯示漫射直接光算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_diffuse_indirect
#. :src: bpy.types.ViewLayer.use_pass_diffuse_indirect
#: scripts/addons_core/cycles/engine.py:207
msgid "Diffuse Indirect"
msgstr "漫射間接光"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_INDIRECT'
msgid "Show the Diffuse Indirect render pass"
msgstr "顯示漫射間接光算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'DIFFUSE_COLOR'
msgid "Show the Diffuse Color render pass"
msgstr "顯示漫射顏色算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_glossy_direct
#. :src: bpy.types.ViewLayer.use_pass_glossy_direct
#: scripts/addons_core/cycles/engine.py:209
msgid "Glossy Direct"
msgstr "光澤直接光"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_DIRECT'
msgid "Show the Glossy Direct render pass"
msgstr "顯示光澤直接光算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_glossy_indirect
#. :src: bpy.types.ViewLayer.use_pass_glossy_indirect
#: scripts/addons_core/cycles/engine.py:210
msgid "Glossy Indirect"
msgstr "光澤間接光"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_INDIRECT'
msgid "Show the Glossy Indirect render pass"
msgstr "顯示光澤間接光算繪通道"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_COLOR'
#. :src: bpy.types.RenderLayer.use_pass_glossy_color
#. :src: bpy.types.ViewLayer.use_pass_glossy_color
#: scripts/addons_core/cycles/engine.py:211
#: source/blender/nodes/shader/nodes/node_shader_light_accumulation.cc:32
msgid "Glossy Color"
msgstr "光澤顏色"

#. :src: bpy.types.CyclesView3DShadingSettings.render_pass:'GLOSSY_COLOR'
msgid "Show the Glossy Color render pass"
msgstr "顯示光澤顏色算繪通道"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_DIRECT'
#. :src: bpy.types.RenderLayer.use_pass_transmission_direct
#. :src: bpy.types.ViewLayer.use_pass_transmission_direct
#: scripts/addons_core/cycles/engine.py:212
msgid "Transmission Direct"
msgstr "透射直接光"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_DIRECT'
msgid "Show the Transmission Direct render pass"
msgstr "顯示直接透射光算繪通道"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_INDIRECT'
#. :src: bpy.types.RenderLayer.use_pass_transmission_indirect
#. :src: bpy.types.ViewLayer.use_pass_transmission_indirect
#: scripts/addons_core/cycles/engine.py:213
msgid "Transmission Indirect"
msgstr "透射間接光"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_INDIRECT'
msgid "Show the Transmission Indirect render pass"
msgstr "顯示間接透射光算繪通道"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_COLOR'
#. :src: bpy.types.RenderLayer.use_pass_transmission_color
#. :src: bpy.types.ViewLayer.use_pass_transmission_color
#: scripts/addons_core/cycles/engine.py:214
#: source/blender/nodes/shader/nodes/node_shader_light_accumulation.cc:38
msgid "Transmission Color"
msgstr "透射顏色"

#. :src:
#. bpy.types.CyclesView3DShadingSettings.render_pass:'TRANSMISSION_COLOR'
msgid "Show the Transmission Color render pass"
